# Vercel Cron protection. Create a long random value.
CRON_SECRET=replace_me

# Telegram — use a NEW token after revoking the token that was posted in chat.
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# Google Drive service account. Share your TradingBot folder with this email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=collector@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=replace_me

# Official Friday-close source used by this project.
TWELVE_DATA_API_KEY=replace_me
